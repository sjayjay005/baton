{
  "manifest_version": 3,
  "name": "Baton – Dev & QA Toolkit",
  "short_name": "Baton",
  "version": "0.5.1",
  "description": "Dev & QA toolkit: replay bugs exactly, mock APIs, flip storage flags, decode JWTs, screenshot and send bugs to Azure Boards.",
  "homepage_url": "https://sjayjay005.github.io/baton/",
  "devtools_page": "devtools/devtools.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "cookies",
    "userScripts"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Baton – team links (open DevTools for the toolkit)",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "cycle-1": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Cycle storage value in slot 1"
    },
    "cycle-2": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Cycle storage value in slot 2"
    },
    "cycle-3": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Cycle storage value in slot 3"
    }
  },
  "minimum_chrome_version": "120"
}